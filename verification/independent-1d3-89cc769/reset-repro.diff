+package rag
+
+import (
+ "context"
+ "fmt"
+ "reflect"
+ "sync"
+ "testing"
+ "unsafe"
+ "github.com/wangle201210/go-rag/server/core"
+)
+
+func TestReviewConcurrentResetUsesStableInstance(t *testing.T) {
+ defer resetState()
+ panics := make(chan string, 4096)
+ for round:=0; round<32; round++ {
+  r:=&core.Rag{}
+  root,cancel:=context.WithCancel(context.Background())
+  v:=reflect.ValueOf(r).Elem()
+  for name,value:=range map[string]any{"bgRootCtx":root,"bgRootCancel":cancel,"done":make(chan struct{})} {
+   f:=v.FieldByName(name)
+   reflect.NewAt(f.Type(),unsafe.Pointer(f.UnsafeAddr())).Elem().Set(reflect.ValueOf(value))
+  }
+  ragMu.Lock(); ragSvr=r; vectorStore=&fakeVectorStore{}; ragInit=true; ragMu.Unlock()
+  start:=make(chan struct{})
+  var workers sync.WaitGroup
+  workers.Add(64)
+  for i:=0;i<64;i++ { go func(){
+   defer workers.Done()
+   defer func(){if p:=recover();p!=nil{panics<-fmt.Sprint(p)}}()
+   <-start
+   if err:=Reset();err!=nil{panics<-err.Error()}
+  }() }
+  close(start); workers.Wait(); cancel()
+ }
+ close(panics)
+ count:=0
+ for p:=range panics{if count<3{t.Log(p)};count++}
+ if count>0{t.Fatalf("concurrent Reset produced %d panic/error outcomes",count)}
+}

+package common_test
+import (
+ "context"
+ "errors"
+ "testing"
+ "time"
+ "github.com/wangle201210/go-rag/server/core/providers"
+)
+func TestIndependentSharedTaskKeepsDeadline(t *testing.T){
+ pb,_:=providers.NewProcessBudget(10,0,0,0)
+ tb,err:=pb.NewTaskBudget(context.Background(),providers.WithDeadline(20*time.Millisecond));if err!=nil{t.Fatal(err)}
+ deadlineCtx,cancel:=tb.ContextWithDeadline(context.Background());defer cancel();<-deadlineCtx.Done()
+ if _,err=tb.Reserve(&providers.TokenEstimate{InputTokens:1});!errors.Is(err,context.DeadlineExceeded){t.Fatalf("fixture task must expire: %v",err)}
+ rb,err:=tb.NewSharedRequestBudget(context.Background());if err!=nil{t.Fatal(err)}
+ if l,e:=rb.Reserve(&providers.TokenEstimate{InputTokens:1});e==nil{l.Close();t.Error("shared request view bypassed expired task absolute deadline")}else if !errors.Is(e,context.DeadlineExceeded){t.Fatalf("wrong error %v",e)}
+}

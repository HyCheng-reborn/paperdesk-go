+func reviewProfile(t *testing.T, endpoint string, dim int)*providers.ProviderProfile{
+ t.Helper();p,err:=providers.NewProviderProfile(providers.ProviderProfile{ProviderName:"bailian",Protocol:providers.ProtocolOpenAICompat,Endpoint:endpoint,Model:"test-model",Dimensions:dim});if err!=nil {t.Fatal(err)};return p
+}
+
+func TestReviewRegistryBudgetCoversHTTP(t *testing.T){
+ var sends atomic.Int64
+ srv:=httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter,r *http.Request){sends.Add(1);w.Header().Set("Content-Type","application/json");_,_=w.Write([]byte(`{"id":"x","object":"chat.completion","choices":[{"index":0,"message":{"role":"assistant","content":"ok"},"finish_reason":"stop"}],"usage":{"prompt_tokens":1,"completion_tokens":1,"total_tokens":2}}`))}));defer srv.Close()
+ pb,err:=providers.NewProcessBudget(1,100,0,1);if err!=nil {t.Fatal(err)}
+ client:=srv.Client();client.Timeout=2*time.Second
+ reg,err:=providers.NewRegistry(providers.RegistryConfig{Chat:reviewProfile(t,srv.URL,0),Budget:pb,Transport:providers.NewTransport(providers.WithHTTPClient(client)),Credentials:func(context.Context,*providers.ProviderProfile)(string,error){return "offline-key",nil}});if err!=nil {t.Fatal(err)}
+ role,err:=reg.GetChat(context.Background());if err!=nil {t.Fatal(err)}
+ _,first:=role.Generate(context.Background(),[]*schema.Message{schema.UserMessage("one")});if first!=nil {t.Fatal(first)}
+ _,second:=role.Generate(context.Background(),[]*schema.Message{schema.UserMessage("two")})
+ if !errors.Is(second,providers.ErrBudgetExhausted)||sends.Load()!=1 {t.Fatalf("bound process MaxRequests=1 must limit actual HTTP: sends=%d second=%v snapshot=%+v",sends.Load(),second,pb.Snapshot())}
+}

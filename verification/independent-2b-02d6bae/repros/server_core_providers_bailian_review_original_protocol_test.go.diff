+func TestReviewEmbeddingRawIndices(t *testing.T){
+ cases:=[]struct{name,body string;wantFirst float64;mustReject bool}{
+  {"reordered",`{"data":[{"index":1,"embedding":[0.9]},{"index":0,"embedding":[0.1]}],"usage":{"prompt_tokens":2,"total_tokens":2}}`,0.1,false},
+  {"duplicate",`{"data":[{"index":0,"embedding":[0.1]},{"index":0,"embedding":[0.9]}],"usage":{"prompt_tokens":2,"total_tokens":2}}`,0,true},
+  {"missing",`{"data":[{"embedding":[0.1]},{"index":1,"embedding":[0.9]}],"usage":{"prompt_tokens":2,"total_tokens":2}}`,0,true},
+ }
+ for _,tc:=range cases {t.Run(tc.name,func(t *testing.T){
+  srv:=httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter,r *http.Request){w.Header().Set("Content-Type","application/json");_,_=w.Write([]byte(tc.body))}));defer srv.Close()
+  emb,err:=bailian.BuildEmbed(context.Background(),providers.BuildConfig{Profile:reviewProfile(t,srv.URL,1),APIKey:"offline-key",Transport:providers.NewTransport(providers.WithHTTPClient(srv.Client()))});if err!=nil {t.Fatal(err)}
+  got,err:=emb.EmbedStrings(context.Background(),[]string{"a","b"})
+  if tc.mustReject {if err==nil {t.Fatalf("malformed raw index accepted: %v",got)};return}
+  if err!=nil {return} // rejecting out-of-order raw data also prevents misassociation
+  if len(got)!=2||got[0][0]<tc.wantFirst-1e-6||got[0][0]>tc.wantFirst+1e-6 {t.Fatalf("vector assigned to wrong input: %v",got)}
+ })}
+}

+package rag
+import (
+ "net/http"
+ "net/http/httptest"
+ "sync/atomic"
+ "testing"
+ "github.com/wangle201210/go-rag/server/core/common"
+ "github.com/wangle201210/go-rag/server/core/config"
+ "github.com/wangle201210/go-rag/server/core/providers"
+ "github.com/wangle201210/go-rag/server/core/vector"
+)
+func TestIndependentInitRollbackPreservesNewerRegistry(t *testing.T){
+ old:=common.GetRegistry();defer common.SetRegistry(old)
+ previous:=providers.NewFakeRegistry();newer:=providers.NewFakeRegistry();common.SetRegistry(previous)
+ var sawUnpublished atomic.Bool
+ srv:=httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter,r *http.Request){if common.GetRegistry()!=previous{sawUnpublished.Store(true)};common.SetRegistry(newer);w.Header().Set("X-Elastic-Product","Elasticsearch");w.WriteHeader(http.StatusUnauthorized)}));defer srv.Close()
+ vs,err:=vector.NewESVectorStore(&vector.ESConfig{Address:srv.URL});if err!=nil{t.Fatal(err)};defer vs.Close()
+ cfg:=validRagConfig();cfg.VectorCfg.Type="es";cfg.Provider=&config.ProviderConfig{Name:"bailian",APIKey:"offline-key",BaseURL:"http://example.invalid/v1",ChatModel:"new-model"}
+ _,err=(&defaultRagFactory{}).Create(cfg,vs);if err==nil{t.Fatal("fixture must fail index init")}
+ if sawUnpublished.Load(){t.Error("initialization exposed unfinished Registry to concurrent reader")}
+ if common.GetRegistry()!=newer{t.Error("failed initialization rollback overwrote Registry published during its wait")}
+}

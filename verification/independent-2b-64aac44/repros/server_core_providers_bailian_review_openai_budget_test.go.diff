+ role,err:=reg.GetChat(context.Background());if err!=nil{t.Fatal(err)}
+ for i:=0;i<2;i++{_,_=role.Generate(context.Background(),[]*schema.Message{schema.UserMessage("hi")})}
+ if sends.Load()>1{t.Fatalf("OpenAI builder bypasses budget: sends=%d snapshot=%+v",sends.Load(),pb.Snapshot())}

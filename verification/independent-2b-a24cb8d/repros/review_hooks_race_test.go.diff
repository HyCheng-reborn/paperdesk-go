+
+// Uses only public registration APIs with a private provider name; no package-variable patching.
+func TestReviewHooksConcurrentRegistration(t *testing.T){
+ p,err:=providers.NewProviderProfile(providers.ProviderProfile{ProviderName:"openai",Protocol:providers.ProtocolOpenAICompat,Endpoint:"http://example.invalid/v1",Model:"model"});if err!=nil {t.Fatal(err)}
+ pb,err:=providers.NewProcessBudget(0,0,0,0);if err!=nil {t.Fatal(err)}
+ builder:=func(context.Context,providers.BuildConfig)(providers.ChatRole,error){return providers.NewFakeChat(),nil}
+ start:=make(chan struct{});var wg sync.WaitGroup;wg.Add(2)
+ go func(){defer wg.Done();<-start;for i:=0;i<200;i++{providers.RegisterChatBuilder("review-private-registration",builder);runtime.Gosched()}}()
+ go func(){defer wg.Done();<-start;for i:=0;i<200;i++{reg,err:=providers.NewRegistry(providers.RegistryConfig{Chat:p,Budget:pb,Credentials:func(context.Context,*providers.ProviderProfile)(string,error){return "offline-key",nil}});if err!=nil {t.Error(err);return};if _,err=reg.GetChat(context.Background());err!=nil {t.Error(err);return};runtime.Gosched()}}()
+ close(start);done:=make(chan struct{});go func(){wg.Wait();close(done)}()
+ select {case<-done:case<-time.After(5*time.Second):t.Fatal("registration/build did not finish")}
+}
+
+func TestReviewRegistryConcurrentConstruction(t *testing.T){
+ p,err:=providers.NewProviderProfile(providers.ProviderProfile{ProviderName:"openai",Protocol:providers.ProtocolOpenAICompat,Endpoint:"http://example.invalid/v1",Model:"model"});if err!=nil {t.Fatal(err)}
+ pb,err:=providers.NewProcessBudget(10,100,100,1);if err!=nil {t.Fatal(err)}
+ var calls atomic.Int64
+ reg,err:=providers.NewRegistry(providers.RegistryConfig{Chat:p,Budget:pb,Credentials:func(context.Context,*providers.ProviderProfile)(string,error){calls.Add(1);return "offline-key",nil}});if err!=nil {t.Fatal(err)}
+ const n=32
+ start:=make(chan struct{});out:=make(chan providers.ChatRole,n);fail:=make(chan error,n);var wg sync.WaitGroup
+ for i:=0;i<n;i++{wg.Add(1);go func(){defer wg.Done();<-start;role,err:=reg.GetChat(context.Background());if err!=nil {fail<-err;return};out<-role}()}
+ close(start);done:=make(chan struct{});go func(){wg.Wait();close(done)}()
+ select{case<-done:case<-time.After(5*time.Second):t.Fatal("construction did not finish")}
+ close(out);close(fail);for err:=range fail{t.Error(err)}
+ var first providers.ChatRole;count:=0
+ for role:=range out{count++;if first==nil {first=role};if role!=first {t.Error("one Profile published multiple instances")}}
+ if count!=n||calls.Load()!=1 {t.Fatalf("cache construction count: roles=%d credentials=%d",count,calls.Load())}
+}

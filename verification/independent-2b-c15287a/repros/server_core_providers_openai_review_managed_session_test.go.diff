+// Review-only: exercise the actual nil-lease production builder, not zero limits.
+func TestReviewBailianNilBudgetParentCancel(t *testing.T) {
+ serverDone:=make(chan struct{})
+ srv:=httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter,r *http.Request){defer close(serverDone);w.Header().Set("Content-Type","text/event-stream");for i:=0;i<20;i++{w.Write([]byte("data: {\"choices\":[{\"index\":0,\"delta\":{\"content\":\"chunk\"}}]}\n\n"))};w.(http.Flusher).Flush();<-r.Context().Done()}))
+ ctx,cancel:=context.WithCancel(context.Background());t.Cleanup(func(){cancel();srv.Close()})
+ role:=managedRole(t,srv.URL,"bailian",srv.Client(),nil)
+ ss,e:=role.(providers.StreamSessioner).StreamSession(ctx,[]*schema.Message{schema.UserMessage("hi")});if e!=nil{t.Fatal(e)}
+ t.Cleanup(func(){ss.Close()})
+ deadline:=time.NewTimer(time.Second);defer deadline.Stop();tick:=time.NewTicker(time.Millisecond);defer tick.Stop()
+ for reflect.ValueOf(ss.Reader()).Elem().FieldByName("st").Elem().FieldByName("items").Len()==0{select{case<-tick.C:case<-deadline.C:t.Fatal("nil-budget output buffer never filled")}}
+ cancel()
+ select{case<-serverDone:case<-time.After(time.Second):t.Error("HTTP cancellation did not arrive")}
+ select{case<-ss.Done():case<-time.After(time.Second):t.Error("nil-budget session did not converge from parent cancellation alone")}
+}

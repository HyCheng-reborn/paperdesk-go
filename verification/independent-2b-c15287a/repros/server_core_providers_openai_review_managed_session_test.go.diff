+func managedRole(t *testing.T,url,kind string,client *http.Client,pb *providers.ProcessBudget) providers.ChatRole{
+ t.Helper();p,e:=providers.NewProviderProfile(providers.ProviderProfile{ProviderName:kind,Protocol:providers.ProtocolOpenAICompat,Endpoint:url,Model:"offline"});if e!=nil{t.Fatal(e)}
+ cfg:=providers.BuildConfig{Profile:p,APIKey:"offline",Transport:providers.NewTransport(providers.WithHTTPClient(client)),Budget:pb}
+ var role providers.ChatRole
+ if kind=="bailian"{role,e=bailian.BuildChat(context.Background(),cfg)}else{role,e=providers.BuildChatRole(context.Background(),cfg)};if e!=nil{t.Fatal(e)};return role
+}
+func TestReviewManagedRealClose(t *testing.T){for _,kind:=range []string{"bailian","openai"}{t.Run(kind,func(t *testing.T){
+ handlerDone:=make(chan struct{});srv:=httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter,r *http.Request){defer close(handlerDone);w.Header().Set("Content-Type","text/event-stream");w.Write([]byte("data: {\"choices\":[{\"index\":0,\"delta\":{\"content\":\"first\"}}]}\n\n"));w.(http.Flusher).Flush();<-r.Context().Done()}))
+ ctx,cancel:=context.WithCancel(context.Background());t.Cleanup(func(){cancel();srv.Close()})
+ pb,_:=providers.NewProcessBudget(5,0,0,1);role:=managedRole(t,srv.URL,kind,srv.Client(),pb)
+ ss,e:=role.(providers.StreamSessioner).StreamSession(ctx,[]*schema.Message{schema.UserMessage("hi")});if e!=nil{t.Fatal(e)}
+ if _,e=ss.Reader().Recv();e!=nil{t.Fatal(e)}
+ closed:=make(chan struct{});go func(){ss.Close();close(closed)}()
+ select{case<-closed:case<-time.After(time.Second):t.Fatal("managed Close hung")}
+ select{case<-ss.Done():default:t.Error("Done still open")};select{case<-handlerDone:case<-time.After(time.Second):t.Error("server did not observe cancellation")}
+ if pb.Snapshot().InFlight!=0{t.Error("lease still active")}
+})}}
+func TestReviewManagedNoBudgetABC(t *testing.T){
+ srv:=httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter,r *http.Request){w.Header().Set("Content-Type","text/event-stream");for _,part:=range []string{"A","B","C"}{w.Write([]byte("data: {\"choices\":[{\"index\":0,\"delta\":{\"content\":\""+part+"\"}}]}\n\n"))};w.Write([]byte("data: [DONE]\n\n"))}));defer srv.Close()
+ role:=managedRole(t,srv.URL,"bailian",srv.Client(),nil);ss,e:=role.(providers.StreamSessioner).StreamSession(context.Background(),[]*schema.Message{schema.UserMessage("hi")});if e!=nil{t.Fatal(e)};defer ss.Close()
+ var text strings.Builder;for{m,err:=ss.Reader().Recv();if err==io.EOF{break};if err!=nil{t.Fatal(err)};if m!=nil{text.WriteString(m.Content)}};if text.String()!="ABC"{t.Fatalf("got %q",text.String())}
+}
+type holdErrorBody struct{io.ReadCloser; held chan struct{};release chan struct{};once sync.Once}
+func(b *holdErrorBody)Read(p []byte)(int,error){n,e:=b.ReadCloser.Read(p);if e!=nil{b.once.Do(func(){close(b.held)});<-b.release};return n,e}
+type reviewTransport struct{base http.RoundTripper;held,release chan struct{}}
+func(rt reviewTransport)RoundTrip(r *http.Request)(*http.Response,error){resp,e:=rt.base.RoundTrip(r);if e==nil{resp.Body=&holdErrorBody{ReadCloser:resp.Body,held:rt.held,release:rt.release}};return resp,e}
+func TestReviewManagedCloseWaitsReceiver(t *testing.T){
+ held:=make(chan struct{});release:=make(chan struct{});var once sync.Once
+ srv:=httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter,r *http.Request){w.Header().Set("Content-Type","text/event-stream");w.Write([]byte("data: {\"choices\":[{\"index\":0,\"delta\":{\"content\":\"first\"}}]}\n\n"));w.(http.Flusher).Flush();<-r.Context().Done()}))
+ ctx,cancel:=context.WithCancel(context.Background());t.Cleanup(func(){once.Do(func(){close(release)});cancel();srv.Close()})
+ var role providers.ChatRole
+ // Explicit nonnil budget selects the production budget wrapper.
+ pb,_:=providers.NewProcessBudget(5,0,0,1);role=managedRole(t,srv.URL,"openai",&http.Client{Transport:reviewTransport{base:http.DefaultTransport,held:held,release:release}},pb)
+ ss,e:=role.(providers.StreamSessioner).StreamSession(ctx,[]*schema.Message{schema.UserMessage("hi")});if e!=nil{t.Fatal(e)};if _,e=ss.Reader().Recv();e!=nil{t.Fatal(e)}
+ closed:=make(chan struct{});go func(){ss.Close();close(closed)}()
+ select{case<-held:case<-time.After(time.Second):t.Fatal("HTTP read did not reach controlled cancellation completion")}
+ // The SDK cannot publish its error/EOF until Read returns; the provider recv worker is still blocked.
+ select{case<-closed:t.Error("Close/Done returned while provider receiver was still blocked behind HTTP Read completion");case<-time.After(50*time.Millisecond):}
+ once.Do(func(){close(release)});select{case<-closed:case<-time.After(time.Second):t.Error("Close did not finish after source released")}
+}

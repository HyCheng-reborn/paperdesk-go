+func TestReviewManagedParentCancelUnderBackpressure(t *testing.T){
+ serverDone:=make(chan struct{})
+ srv:=httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter,r *http.Request){defer close(serverDone);w.Header().Set("Content-Type","text/event-stream");for i:=0;i<20;i++{w.Write([]byte("data: {\"choices\":[{\"index\":0,\"delta\":{\"content\":\"chunk\"}}]}\n\n"))};w.(http.Flusher).Flush();<-r.Context().Done()}))
+ ctx,cancel:=context.WithCancel(context.Background());t.Cleanup(func(){cancel();srv.Close()})
+ pb,_:=providers.NewProcessBudget(5,0,0,1);role:=managedRole(t,srv.URL,"openai",srv.Client(),pb)
+ ss,e:=role.(providers.StreamSessioner).StreamSession(ctx,[]*schema.Message{schema.UserMessage("hi")});if e!=nil{t.Fatal(e)}
+ // Read-only observation of the pinned Eino Pipe buffer; do not consume it and relieve backpressure.
+ deadline:=time.NewTimer(time.Second);defer deadline.Stop();tick:=time.NewTicker(time.Millisecond);defer tick.Stop()
+ for reflect.ValueOf(ss.Reader()).Elem().FieldByName("st").Elem().FieldByName("items").Len()==0{select{case<-tick.C:case<-deadline.C:cancel();ss.Close();t.Fatal("output buffer never filled")}}
+ cancel()
+ select{case<-serverDone:case<-time.After(time.Second):t.Error("HTTP parent cancellation did not arrive")}
+ select{case<-ss.Done():case<-time.After(100*time.Millisecond):t.Errorf("parent canceled HTTP but buffered session did not converge: %+v",pb.Snapshot())}
+ ss.Close() // explicit failure cleanup releases the stuck forwarding Send
+}

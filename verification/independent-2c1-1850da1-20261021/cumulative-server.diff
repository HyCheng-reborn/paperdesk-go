+	cfg.EmbeddingDimensions = 768
+	vf := &dimensionVSFactory{vs: &fakeVectorStore{}}
+	rf := &dimensionRagFactory{}
+	if e := InitWith(cfg, vf, rf); e != nil {
+		t.Fatal(e)
+	}
+	if vf.got != 768 || rf.got != 768 {
+		t.Fatal(vf.got, rf.got)

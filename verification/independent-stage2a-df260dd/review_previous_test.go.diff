+func TestReviewBudget_InvalidUsageConservative(t *testing.T) {
+ for _, tc := range []struct{name string; u *model.TokenUsage}{
+  {"negative-component", &model.TokenUsage{PromptTokens:-100,CompletionTokens:1,TotalTokens:1}},
+  {"total-only", &model.TokenUsage{TotalTokens:1}},
+ } {
+  t.Run(tc.name,func(t *testing.T){
+   pb:=reviewProcessBudget(t,0,100,100,1)
+   rb,err:=pb.NewRequestBudget(context.Background()); if err!=nil {t.Fatal(err)}
+   l,err:=rb.Reserve(&TokenEstimate{InputTokens:10,MaxOutput:10}); if err!=nil {t.Fatal(err)}
+   if err=l.Commit();err!=nil {t.Fatal(err)}
+   l.Finish(tc.u)
+   s:=pb.Snapshot()
+   extra,sendErr:=rb.Reserve(&TokenEstimate{InputTokens:100,MaxOutput:0})
+   if extra!=nil {extra.Close()}
+   if s.InputUsed<10 || s.OutputUsed<10 || !errors.Is(sendErr,ErrBudgetExhausted) {
+    t.Fatalf("invalid/incomplete usage must retain reservation and reject extra: snapshot=%+v extraReserve=%v",s,sendErr)
+   }
+  })
+ }
+}
+
+func TestReviewBudget_SettlementOverflow(t *testing.T) {
+ pb:=reviewProcessBudget(t,0,100,100,0)
+ rb,err:=pb.NewRequestBudget(context.Background()); if err!=nil {t.Fatal(err)}
+ leases:=make([]*AttemptLease,2)
+ for i:=range leases {leases[i],err=rb.Reserve(&TokenEstimate{InputTokens:1,MaxOutput:1});if err!=nil {t.Fatal(err)};if err=leases[i].Commit();err!=nil {t.Fatal(err)}}
+ for _,l:=range leases {l.Finish(&model.TokenUsage{PromptTokens:int(math.MaxInt64),CompletionTokens:0,TotalTokens:int(math.MaxInt64)})}
+ s:=pb.Snapshot()
+ next,reserveErr:=rb.Reserve(&TokenEstimate{InputTokens:1,MaxOutput:0});if next!=nil {next.Close()}
+ if s.InputUsed<0 || !errors.Is(reserveErr,ErrBudgetExhausted) {t.Fatalf("settlement overflow must fail closed: snapshot=%+v extraReserve=%v",s,reserveErr)}
+}
+
+func TestReviewBudget_NegativeProcessLimit(t *testing.T) {
+ pb,err:=NewProcessBudget(-1,-1,-1,-1)
+ if pb!=nil || !errors.Is(err,ErrBudgetInvalidOption) {t.Fatalf("negative config accepted: pb=%v err=%v",pb,err)}
+}
+func TestReviewBudget_OwnerCancellation(t *testing.T) {
+ ctx,cancel:=context.WithCancel(context.Background())
+ pb:=reviewProcessBudget(t,10,100,100,1)
+ rb,err:=pb.NewRequestBudget(ctx);if err!=nil {t.Fatal(err)}
+ cancel()
+ l,err:=rb.Reserve(&TokenEstimate{InputTokens:1,MaxOutput:1});if l!=nil {l.Close()}
+ if !errors.Is(err,context.Canceled) {t.Fatalf("owner cancellation lost: Reserve=%v",err)}
+}
+
+func TestReviewBudget_AbsoluteDeadline(t *testing.T) {
+ pb:=reviewProcessBudget(t,10,100,100,1)
+ rb,err:=pb.NewRequestBudget(context.Background(),WithDeadline(20*time.Millisecond));if err!=nil {t.Fatal(err)}
+ first,cancel1:=rb.ContextWithDeadline(context.Background());defer cancel1()
+ select {case <-first.Done():case <-time.After(time.Second):t.Fatal("deadline did not fire")}
+ second,cancel2:=rb.ContextWithDeadline(context.Background());defer cancel2()
+ l,reserveErr:=rb.ReserveCtx(second,&TokenEstimate{InputTokens:1,MaxOutput:1});if l!=nil {l.Close()}
+ d1,_:=first.Deadline();d2,_:=second.Deadline()
+ if d2.After(d1) || !errors.Is(reserveErr,context.DeadlineExceeded) {t.Fatalf("same owner refreshed absolute deadline: first=%v second=%v Reserve=%v",d1,d2,reserveErr)}
+}
+
+func TestReviewProfile_RegistryOwnsSnapshot(t *testing.T) {
+ p:=testChatProfile(t,"original-model")
+ var resolvedModel string
+ reg,err:=NewRegistry(RegistryConfig{Chat:p,Budget:reviewProcessBudget(t,1,100,100,1),Credentials:func(_ context.Context,p *ProviderProfile)(string,error){resolvedModel=p.Model;return "offline-key",nil}})
+ if err!=nil {t.Fatal(err)}
+ p.Model="mutated-after-registry-construction"
+ role,err:=reg.GetChat(context.Background());if err!=nil {t.Fatal(err)}
+ got:=role.(interface{Profile()ProviderProfile}).Profile()
+ if resolvedModel!="original-model" || got.Model!="original-model" {t.Fatalf("caller changed registry identity: resolved=%q roleProfile=%q",resolvedModel,got.Model)}
+}
+
+func TestReviewProfile_CacheKeyCollision(t *testing.T) {
+ a:=testChatProfile(t,"same-model");b:=a.Clone()
+ a.KeyOptions=map[string]string{"a":"1,b=2"}
+ b.KeyOptions=map[string]string{"a":"1","b":"2"}
+ a,err:=NewProviderProfile(*a);if err!=nil {t.Fatal(err)}
+ b,err=NewProviderProfile(*b);if err!=nil {t.Fatal(err)}
+ if a.CacheKey()!=b.CacheKey() {return}
+ reg,err:=NewRegistry(RegistryConfig{Chat:a,QA:b,Budget:reviewProcessBudget(t,1,100,100,1),Credentials:func(context.Context,*ProviderProfile)(string,error){return "offline-key",nil}});if err!=nil {t.Fatal(err)}
+ chat,err:=reg.GetChat(context.Background());if err!=nil {t.Fatal(err)}
+ qa,err:=reg.GetQA(context.Background());if err!=nil {t.Fatal(err)}
+ if chat==qa {t.Fatal("different accepted KeyOptions produced same key and reused one cached model")}
+}
+
+
+// Only adapts the changed constructor signature; never bypasses the production constructor.
+func reviewProcessBudget(t *testing.T, a,b,c int64,d int)*ProcessBudget {
+ t.Helper()
+ pb,err:=NewProcessBudget(a,b,c,d);if err!=nil {t.Fatal(err)};return pb
+}
